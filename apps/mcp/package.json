{
  "name": "@deck-club/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS MCP server: Streamable HTTP endpoint that lets a user's own AI assistant work with Deck Club through the core API",
  "scripts": {
    "dev": "node --import tsx scripts/build-views.mjs && node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "build": "node --import tsx scripts/build-views.mjs && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json && node ../../node_modules/typescript-native/bin/tsc -p src/modules/widgets/views/browser/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "clean": "rimraf dist",
    "build:views": "node --import tsx scripts/build-views.mjs"
  },
  "dependencies": {
    "@deck-club/contracts": "workspace:*",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "fastify": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deck-club/config": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
