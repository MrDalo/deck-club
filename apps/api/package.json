{
  "name": "@deck-club/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS core API: the modular monolith that owns every business rule. The web app and the MCP server are its two clients.",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "build": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@deck-club/contracts": "workspace:*",
    "@libsql/client": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deck-club/config": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
