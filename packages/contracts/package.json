{
  "name": "@deck-club/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas, DTO types and error codes shared by the web app, the API and the MCP server. The single source of every boundary shape.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deck-club/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
