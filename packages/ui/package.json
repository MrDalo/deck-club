{
  "name": "@deck-club/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deck Club component library: shadcn/ui primitives (src/ui, vendored) wrapped into branded components (src/components) in the pastel brand theme. Used by the web app and the MCP Apps views.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./src/styles/theme.css",
    "./styles.css": "./dist/styles.css",
    "./*": {
      "source": "./src/components/*/index.tsx",
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "imports": {
    "#ui/hooks/*": {
      "source": "./src/ui/hooks/*.ts",
      "types": "./dist/ui/hooks/*.d.ts",
      "default": "./dist/ui/hooks/*.js"
    },
    "#ui/*": {
      "source": "./src/ui/*.tsx",
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "#lib/*": {
      "source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "#components/*": {
      "source": "./src/components/*/index.tsx",
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.build.json && tailwindcss -i src/styles/globals.css -o dist/styles.css --minify",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0 && node scripts/ui-lock.mjs --check",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "ui:add": "node scripts/ui-add.mjs",
    "ui:lock": "node scripts/ui-lock.mjs --write",
    "clean": "rimraf dist storybook-static"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-table": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "radix-ui": "catalog:",
    "react-day-picker": "catalog:",
    "react-is": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "vaul": "catalog:"
  },
  "devDependencies": {
    "@deck-club/config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "shadcn": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
