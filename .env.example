# Deck Club — copy to `.env` at the repository root. One file feeds `pnpm dev`
# (every app loads it) and `docker compose` (variable substitution).
# Never commit `.env`. Public values (NEXT_PUBLIC_*) end up in the browser bundle.

# --- Supabase Auth (Project Settings → API) -------------------------------
# The API verifies access tokens against this project's published JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable (or legacy anon) key. Never the secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Local development (pnpm dev) -----------------------------------------
# Docker Compose overrides these with private-network addresses.
API_PORT=4000
MCP_PORT=4100
API_INTERNAL_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_MCP_URL=http://localhost:4100/mcp
# SQLite through libSQL, relative to apps/api.
DATABASE_URL=file:./data/deck-club.db
LOG_FORMAT=pretty
